{
  "name": "discord-broadcast",
  "version": "1.0.0",
  "description": "Real-time Discord voice broadcast — 1 source to N channels",
  "main": "src/index.js",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "start": "node src/index.js",
    "register": "node scripts/register-commands.js",
    "test": "node --test tests/test-audio.js tests/test-dispatcher.js",
    "test:audio": "node --test tests/test-audio.js",
    "test:dispatcher": "node --test tests/test-dispatcher.js",
    "bench": "node tests/bench-latency.js"
  },
  "dependencies": {
    "discord.js": "14.26.4",
    "@discordjs/voice": "0.19.2",
    "@discordjs/opus": "0.10.0",
    "prism-media": "1.3.5",
    "sodium-native": "5.1.0",
    "libsodium-wrappers": "0.7.16",
    "tweetnacl": "1.0.3",
    "ffmpeg-static": "5.3.0",
    "@snazzah/davey": "0.1.11",
    "winston": "3.19.0"
  },
  "license": "MIT"
}
